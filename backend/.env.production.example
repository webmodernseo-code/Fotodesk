# FotoDesk Backend - Production Environment Template
NODE_ENV=production
PORT=3001
APP_URL=https://app.fotodesk.io
CORS_ORIGIN=https://app.fotodesk.io

# JWT & Session Security (generate strong 64-byte secrets)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
BACKUP_MANIFEST_KEY=CHANGE_ME_64_HEX_CHARS

# PostgreSQL Database
DB_TYPE=postgres
DATABASE_URL=postgres://fotodesk:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/fotodesk_prod

# Cloudflare R2 Object Storage (S3-compatible)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=fotodesk-media-prod
R2_PUBLIC_URL=https://cdn.fotodesk.io

# Transactional Email (Resend / Postmark / SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
EMAIL_FROM=FotoDesk <noreply@fotodesk.io>

